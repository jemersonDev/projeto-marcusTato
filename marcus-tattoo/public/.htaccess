# Hostinger / Apache — site estático exportado pelo Next.js
# Coloque este arquivo junto do conteúdo da pasta /out no servidor.

# Sem listagem de pastas
Options -Indexes

# Força HTTPS (também atrás de proxy/CDN que repassa X-Forwarded-Proto)
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Bloqueia arquivos ocultos (.git, .env, .htpasswd...), exceto .well-known
RewriteRule "(^|/)\.(?!well-known/)" - [F,L]

# ---------------------------------------------------------------------------
# Cabeçalhos de segurança
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # HSTS: o navegador passa a usar sempre HTTPS (1 ano)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # CSP: o Next.js exportado usa scripts/estilos inline, por isso 'unsafe-inline'.
  # frame-src libera só o Google Maps (seção Localização) e YouTube (vídeos futuros).
  # blob: = prévia local da imagem de referência no atendimento.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; frame-src https://www.google.com https://www.youtube-nocookie.com https://www.youtube.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

  # HTML nunca fica em cache (para novas versões aparecerem na hora)
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Arquivos com hash no nome (/_next/static) nunca mudam: cache longo
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# ---------------------------------------------------------------------------
# Cache de assets estáticos
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Tipos corretos (evita o navegador "adivinhar" com nosniff ativo)
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType font/woff2 .woff2
</IfModule>

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/json application/javascript text/javascript image/svg+xml
</IfModule>

# Página 404
ErrorDocument 404 /404.html
